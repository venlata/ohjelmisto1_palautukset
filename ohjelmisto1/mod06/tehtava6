numerot = []

while True:
    kysmys = input("Anna numero: ")
    if kysmys == "":
        break
    numerot.append(int(kysmys))

numerot.sort(reverse=True)
for aaa in range(5):
    print(numerot[aaa])

#Tehtävä 6 osa 3

aluku = int(input("Anna kokonaisluku:\n"))
onaluku = True

if aluku < 2:
    onaluku = False
else:
    for llluku in range(2, aluku):
        if aluku % llluku == 0:
            onaluku = False
            break
if onaluku:
    print("Luku on alkuluku.")
else:
    print("Lukusi ei ole alkuluku.")
    
